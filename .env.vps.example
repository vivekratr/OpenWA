# Copy to .env before: docker compose -f docker-compose.vps.yml up -d --build

# API (expose on VPS — open firewall TCP 2785 or put Caddy/nginx in front)
API_PORT=2785
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL (used by postgres service)
DATABASE_TYPE=postgres
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis + queue (required for scheduled WhatsApp messages)
REDIS_ENABLED=true
QUEUE_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# Allow your Vercel frontend (comma-separated, no trailing slashes)
CORS_ORIGINS=https://your-app.vercel.app

# WhatsApp engine
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=/app/data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media

# Optional: lock down admin API
# API_MASTER_KEY=
